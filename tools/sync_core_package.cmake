# Keep the self-contained tutorial assets synchronized from the reference package.
# Run from the repository root: cmake [-DMODE=UPDATE] -P tools/sync_core_package.cmake
cmake_minimum_required(VERSION 3.16.2)

if(NOT DEFINED MODE)
	set(MODE CHECK)
endif()
if(NOT MODE STREQUAL "CHECK" AND NOT MODE STREQUAL "UPDATE")
	message(FATAL_ERROR "MODE must be CHECK or UPDATE")
endif()
get_filename_component(hg_repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(hg_source "${hg_repo}/core-package/core")
set(hg_target "${hg_repo}/tutorials/resources/core")
file(GLOB_RECURSE hg_source_files LIST_DIRECTORIES false RELATIVE "${hg_source}" "${hg_source}/*")
file(GLOB_RECURSE hg_target_files LIST_DIRECTORIES false RELATIVE "${hg_target}" "${hg_target}/*")
if(NOT hg_source_files)
	message(FATAL_ERROR "Reference core package is empty or missing: ${hg_source}")
endif()

# Report tutorial-only resources for review; never remove them implicitly.
set(hg_extra "")
foreach(hg_path IN LISTS hg_target_files)
	if(NOT hg_path IN_LIST hg_source_files)
		list(APPEND hg_extra "${hg_path}")
	endif()
endforeach()
if(hg_extra)
	message(FATAL_ERROR "Tutorial-only core resources must be reconciled with core-package first: ${hg_extra}")
endif()

set(hg_differences "")
foreach(hg_path IN LISTS hg_source_files)
	file(SHA256 "${hg_source}/${hg_path}" hg_source_hash)
	set(hg_target_hash "missing")
	if(EXISTS "${hg_target}/${hg_path}")
		file(SHA256 "${hg_target}/${hg_path}" hg_target_hash)
	endif()
	if(NOT hg_source_hash STREQUAL hg_target_hash)
		list(APPEND hg_differences "${hg_path}")
		if(MODE STREQUAL "UPDATE")
			get_filename_component(hg_parent "${hg_target}/${hg_path}" DIRECTORY)
			file(MAKE_DIRECTORY "${hg_parent}")
			configure_file("${hg_source}/${hg_path}" "${hg_target}/${hg_path}" COPYONLY)
		endif()
	endif()
endforeach()
if(hg_differences AND MODE STREQUAL "CHECK")
	message(FATAL_ERROR "Tutorial core differs from the reference package: ${hg_differences}. Run with -DMODE=UPDATE to synchronize.")
endif()
list(LENGTH hg_source_files hg_count)
list(LENGTH hg_differences hg_changed)
message(STATUS "Core package ${MODE}: ${hg_count} reference files, ${hg_changed} differences")
