cmake_minimum_required(VERSION 3.16.2)
foreach(hg_required REPO BUILD CONFIG ROOT API PLATFORM ARCH TOOLCHAIN)
	if(NOT DEFINED ${hg_required} OR "${${hg_required}}" STREQUAL "")
		message(FATAL_ERROR "Missing package parameter: ${hg_required}")
	endif()
endforeach()
set(hg_source "${ROOT}/source")
set(hg_app "${ROOT}/app")
set(hg_compiled "${hg_app}/resources_compiled")
file(MAKE_DIRECTORY "${hg_source}" "${hg_app}")
# An old manifest must not advertise a failed rebuild as a valid distribution.
file(REMOVE "${hg_app}/manifest.json")

execute_process(COMMAND "${CMAKE_COMMAND}" -P "${REPO}/tools/sync_core_package.cmake"
	RESULT_VARIABLE hg_result)
if(NOT hg_result EQUAL 0)
	message(FATAL_ERROR "Tutorial core mirror check failed")
endif()

function(hg_stage original relative)
	get_filename_component(hg_parent "${hg_source}/${relative}" DIRECTORY)
	file(MAKE_DIRECTORY "${hg_parent}")
	configure_file("${original}" "${hg_source}/${relative}" COPYONLY)
endfunction()

# Stage canonical core shaders and only programs used by this application.
file(GLOB hg_gaussian "${REPO}/core-package/core/gaussian_splatting/*")
file(GLOB hg_headers "${REPO}/core-package/core/shader/*.sh")
foreach(hg_path IN LISTS hg_gaussian hg_headers)
	file(RELATIVE_PATH hg_relative "${REPO}/core-package" "${hg_path}")
	hg_stage("${hg_path}" "${hg_relative}")
endforeach()
foreach(hg_program imgui imgui_image)
	foreach(hg_part vs.sc fs.sc varying.def)
		hg_stage("${REPO}/core-package/core/shader/${hg_program}_${hg_part}"
			"core/shader/${hg_program}_${hg_part}")
	endforeach()
endforeach()
foreach(hg_part vs.sc fs.sc varying.def)
	hg_stage("${REPO}/tutorials/resources/gaussian_splatting/shaders/gizmo_${hg_part}"
		"gaussian_splatting/shaders/gizmo_${hg_part}")
endforeach()
foreach(hg_model gaussian_splatting/source/plant.splat gaussian_splatting/source/saari-probe.spz)
	if(NOT EXISTS "${REPO}/tutorials/resources/${hg_model}")
		message(FATAL_ERROR "Two-model tutorial requires tutorials/resources/${hg_model}")
	endif()
	hg_stage("${REPO}/tutorials/resources/${hg_model}" "${hg_model}")
	hg_stage("${REPO}/tutorials/resources/${hg_model}.meta" "${hg_model}.meta")
endforeach()
configure_file("${REPO}/tutorials/gaussian_splatting.lua" "${hg_app}/gaussian_splatting.lua" COPYONLY)

# Use install rules so relative runtime paths and shared dependencies match a
# clean distribution rather than the developer's build-tree search paths.
foreach(hg_component assetc gsplat_tutorial_runtime)
	if(hg_component STREQUAL "assetc")
		set(hg_prefix "${ROOT}/tools")
	else()
		set(hg_prefix "${hg_app}")
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --config "${CONFIG}"
		--component "${hg_component}" --prefix "${hg_prefix}"
		OUTPUT_FILE "${ROOT}/install-${hg_component}.log" ERROR_VARIABLE hg_error
		RESULT_VARIABLE hg_result)
	if(NOT hg_result EQUAL 0)
		message(FATAL_ERROR "Install ${hg_component} failed: ${hg_error}")
	endif()
endforeach()
if(PLATFORM STREQUAL "windows")
	set(hg_exe .exe)
else()
	set(hg_exe "")
endif()
set(hg_tools "${ROOT}/tools/assetc/toolchains/${TOOLCHAIN}")
set(hg_assetc "${ROOT}/tools/assetc/assetc${hg_exe}")
set(hg_identity "${API}/${PLATFORM}/${ARCH}/${CONFIG}")
foreach(hg_tool "${hg_assetc}" "${hg_tools}/shaderc${hg_exe}" "${hg_tools}/gsplatc${hg_exe}")
	file(SHA256 "${hg_tool}" hg_hash)
	string(APPEND hg_identity "/${hg_hash}")
endforeach()
set(hg_previous "")
if(EXISTS "${ROOT}/toolchain-identity.txt")
	file(READ "${ROOT}/toolchain-identity.txt" hg_previous)
endif()
if(NOT hg_previous STREQUAL hg_identity)
	file(REMOVE "${hg_compiled}/assetc.cab")
endif()
execute_process(COMMAND "${hg_assetc}" -api "${API}" -platform "${PLATFORM}"
	-toolchain "${hg_tools}" "${hg_source}" "${hg_compiled}"
	OUTPUT_VARIABLE hg_log ERROR_VARIABLE hg_error RESULT_VARIABLE hg_result)
file(WRITE "${ROOT}/assetc.log" "${hg_log}\n${hg_error}")
if(NOT hg_result EQUAL 0 OR NOT hg_log MATCHES "[\r\n] +0 failed")
	message(FATAL_ERROR "Tutorial asset compilation failed; see ${ROOT}/assetc.log")
endif()
set(hg_outputs core/gaussian_splatting/clear.sc core/gaussian_splatting/project.sc
	core/gaussian_splatting/sort.sc core/gaussian_splatting/sort_local.sc core/gaussian_splatting/gather.sc
	core/gaussian_splatting/radix_histogram.sc core/gaussian_splatting/radix_prefix.sc core/gaussian_splatting/radix_scatter.sc
	core/gaussian_splatting/splat.vsb core/gaussian_splatting/splat.fsb
	core/shader/imgui.vsb core/shader/imgui.fsb core/shader/imgui_image.vsb core/shader/imgui_image.fsb
	gaussian_splatting/shaders/gizmo.vsb gaussian_splatting/shaders/gizmo.fsb
	gaussian_splatting/source/plant.hgs gaussian_splatting/source/saari-probe.hgs)
set(hg_hashes "")
foreach(hg_output IN LISTS hg_outputs)
	if(NOT EXISTS "${hg_compiled}/${hg_output}")
		message(FATAL_ERROR "Missing required compiled resource: ${hg_output}")
	endif()
	file(SIZE "${hg_compiled}/${hg_output}" hg_size)
	if(hg_size EQUAL 0)
		message(FATAL_ERROR "Empty compiled resource: ${hg_output}")
	endif()
	file(SHA256 "${hg_compiled}/${hg_output}" hg_hash)
	string(APPEND hg_hashes "    \"${hg_output}\": \"${hg_hash}\",\n")
endforeach()
file(SHA256 "${hg_app}/gaussian_splatting.lua" hg_lua_hash)
string(APPEND hg_hashes "    \"gaussian_splatting.lua\": \"${hg_lua_hash}\"\n")
set(hg_inputs "")
file(GLOB_RECURSE hg_input_files LIST_DIRECTORIES false RELATIVE "${hg_source}" "${hg_source}/*")
foreach(hg_input IN LISTS hg_input_files)
	file(SHA256 "${hg_source}/${hg_input}" hg_hash)
	if(hg_inputs)
		string(APPEND hg_inputs ",\n")
	endif()
	string(APPEND hg_inputs "    \"${hg_input}\": \"${hg_hash}\"")
endforeach()
set(hg_binaries "")
file(GLOB hg_binary_files "${hg_app}/*.so" "${hg_app}/*.dll" "${hg_app}/*.dylib" "${hg_app}/lua" "${hg_app}/lua.exe")
foreach(hg_binary IN LISTS hg_binary_files)
	file(SHA256 "${hg_binary}" hg_hash)
	get_filename_component(hg_name "${hg_binary}" NAME)
	if(hg_binaries)
		string(APPEND hg_binaries ",\n")
	endif()
	string(APPEND hg_binaries "    \"${hg_name}\": \"${hg_hash}\"")
endforeach()
execute_process(COMMAND git -C "${REPO}" rev-parse HEAD
	OUTPUT_VARIABLE hg_revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE hg_result)
if(NOT hg_result EQUAL 0)
	set(hg_revision "source-archive")
endif()
execute_process(COMMAND git -C "${REPO}" diff --quiet HEAD RESULT_VARIABLE hg_result)
if(hg_result EQUAL 0)
	set(hg_dirty false)
else()
	set(hg_dirty true)
endif()
file(WRITE "${ROOT}/toolchain-identity.txt" "${hg_identity}")
file(WRITE "${hg_app}/manifest.json" "{\n  \"version\": 1,\n  \"source_revision\": \"${hg_revision}\",\n  \"source_tree_dirty\": ${hg_dirty},\n  \"backend\": \"${API}\",\n  \"platform\": \"${PLATFORM}\",\n  \"architecture\": \"${ARCH}\",\n  \"configuration\": \"${CONFIG}\",\n  \"toolchain_identity\": \"${hg_identity}\",\n  \"input_sha256\": {\n${hg_inputs}\n  },\n  \"runtime_sha256\": {\n${hg_binaries}\n  },\n  \"sha256\": {\n${hg_hashes}  }\n}\n")
if(PLATFORM STREQUAL "osx")
	file(WRITE "${hg_app}/run.command" "#!/bin/sh\ncd -- \"$(dirname -- \"$0\")\" || exit 1\nexport LUA_CPATH='./?.so;;'\nexec ./lua gaussian_splatting.lua\n")
	execute_process(COMMAND chmod +x "${hg_app}/run.command" RESULT_VARIABLE hg_result)
	if(NOT hg_result EQUAL 0)
		message(FATAL_ERROR "Cannot make run.command executable")
	endif()
else()
	file(WRITE "${hg_app}/run.bat" "@echo off\r\ncd /d \"%~dp0\"\r\nset LUA_CPATH=.\\?.dll;;\r\nlua.exe gaussian_splatting.lua\r\n")
endif()
message(STATUS "Gaussian tutorial package: ${hg_app}; shaders: ${API}/${PLATFORM}")
